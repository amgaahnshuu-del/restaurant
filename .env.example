NEXT_PUBLIC_APP_URL="http://localhost:3000"

DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME"

# Auth — generate with: openssl rand -base64 48  (min 32 chars, never the placeholder)
JWT_SECRET="your-jwt-secret"

# Secret the Vercel Cron job sends as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET="your-cron-secret"

# Restaurant local timezone (IANA name, e.g. Asia/Ulaanbaatar)
RESTAURANT_TIMEZONE="Asia/Ulaanbaatar"

# Email — leave RESEND_API_KEY empty to fall back to console logging
RESEND_API_KEY=""
EMAIL_FROM="Gilded Plates <onboarding@resend.dev>"

# Rate limiting — set BOTH to use distributed Redis (needed on serverless /
# multi-instance). Leave empty to use the in-memory fallback (single instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Payment / QPay — leave QPAY_* empty for sandbox (mock QR) mode.
# Provide all of USERNAME/PASSWORD/INVOICE_CODE to enable real QPay invoices.
RESERVATION_FEE_MNT="50000"
QPAY_BASE_URL="https://merchant.qpay.mn/v2"
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
QPAY_CALLBACK_URL=""

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-admin-password"
CUSTOMER_EMAIL="guest@example.com"
CUSTOMER_PASSWORD="your-customer-password"
CUSTOMER_NAME="Guest User"
CUSTOMER_PHONE="+976 99112233"
